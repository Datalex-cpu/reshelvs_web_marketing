# Resend (transactional email + waitlist confirmations)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
RESEND_FROM=hello@reshelvs.com
# Optional — only set if you want waitlist signups added to a Resend audience.
RESEND_AUDIENCE_ID=
# Where /api/contact submissions are forwarded.
CONTACT_INBOX=sales@reshelvs.com

# PostHog (analytics)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry (errors)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Public site URL (used by sitemap, OG)
NEXT_PUBLIC_SITE_URL=https://reshelvs.com
